# Copy this file to `.env` and fill in your own keys. NEVER commit the real .env.
# (.env is gitignored; only this .env.example template is tracked.)

# ─── Required: NVIDIA NIM ────────────────────────────────────────────────────
# Used by RAGG.py for indexing, retrieval, and answering via litellm's
# `nvidia_nim/` provider. Get one at https://build.nvidia.com.
NVIDIA_API_KEY=

# ─── Optional: OpenAI-compatible endpoints ───────────────────────────────────
# PageIndex core (pageindex/) reads OPENAI_API_KEY directly. RAGG.py already
# maps NVIDIA_API_KEY onto it automatically, so set this only if you run
# run_pageindex.py against OpenAI itself or another OpenAI-compatible endpoint.
# CHATGPT_API_KEY is supported as a backward-compatible alias.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
